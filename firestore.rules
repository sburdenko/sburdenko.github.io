rules_version = '2';

// Жалобы на карточки Bathys: любой может создать отчёт нужной формы, читать, менять и удалять —
// никто (читаем мы через консоль или сервисный аккаунт, в обход правил).
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'courseId', 'lessonId', 'cardIndex', 'cardType', 'snippet', 'lang',
          'categories', 'text', 'uid', 'ver', 'wasWrong', 'createdAt'])
        && request.resource.data.keys().hasAll([
          'courseId', 'lessonId', 'cardIndex', 'cardType', 'snippet', 'lang', 'categories', 'text', 'createdAt'])
        && request.resource.data.courseId is string && request.resource.data.courseId.size() <= 40
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 40
        && request.resource.data.cardIndex is int && request.resource.data.cardIndex >= 0 && request.resource.data.cardIndex < 100
        && request.resource.data.cardType is string && request.resource.data.cardType.size() <= 20
        && request.resource.data.snippet is string && request.resource.data.snippet.size() <= 300
        && request.resource.data.lang in ['ru', 'en']
        && request.resource.data.categories is list && request.resource.data.categories.size() <= 10
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (request.resource.data.categories.size() > 0 || request.resource.data.text.size() > 0)
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data) || request.resource.data.uid == null || request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if false;
    }
  }
}
