   "code": "public int[][] Insert(int[][] ivs, int[] add) {\n    var res = new List<int[]>();\n    int i = 0, n = ivs.Length, s = add[0], e = add[1];\n    while (i < n && ivs[i][1] <= s) res.Add(ivs[i++]);\n    while (i < n && ivs[i][0] <= e) {\n        s = Math.Min(s, ivs[i][0]);\n        e = Math.Max(e, ivs[i][1]);\n        i++;\n    }\n    res.Add(new[] { s, e });\n    while (i < n) res.Add(ivs[i++]);\n    return res.ToArray();\n}",
