   "code": "public int[][] KClosest(int[][] points, int k) {\n    var heap = new PriorityQueue<int[], int>();\n    foreach (var p in points) {\n        int d = p[0] * p[0] + p[1] * p[1];\n        heap.Enqueue(p, d);\n        if (heap.Count > k) heap.Dequeue();\n    }\n    var res = new int[k][];\n    for (int i = 0; i < k; i++) res[i] = heap.Dequeue();\n    return res;\n}",
   "answer": 1,
