   "code": "public int LengthOfLIS(int[] nums) {\n    var tails = new int[nums.Length];\n    int len = 0;\n    foreach (int x in nums) {\n        int lo = 0, hi = len;\n        while (lo < hi) {\n            int mid = lo + (hi - lo) / 2;\n            if (tails[mid] <= x) lo = mid + 1;\n            else hi = mid;\n        }\n        tails[lo] = x;\n        if (lo == len) len++;\n    }\n    return len;\n}",
