   "q": "⟦⟧",
   "code": "public ListNode ReverseKGroup(ListNode head, int k) {\n    var dummy = new ListNode(0, head);\n    var groupPrev = dummy;\n    while (true) {\n        var kth = groupPrev;\n        for (int i = 0; i < k && kth != null; i++) kth = kth.next;\n        if (kth == null) break;\n        var groupNext = kth.next;\n        ListNode prev = null, cur = groupPrev.next;\n        while (cur != groupNext) {\n            var next = cur.next;\n            cur.next = prev;\n            prev = cur;\n            cur = next;\n        }\n        var first = groupPrev.next;\n        groupPrev.next = kth;\n        groupPrev = first;\n    }\n    return dummy.next;\n}",
   "answer": 8,
   "explain": "⟦⟧",
   "lang": "cs"
