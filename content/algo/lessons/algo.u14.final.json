   "code": "class Player { public int Id, Score; }\n\nclass Leaderboard {\n    readonly Dictionary<int, Player> players = new Dictionary<int, Player>();\n    readonly SortedSet<Player> board = new SortedSet<Player>(\n        Comparer<Player>.Create((a, b) => b.Score.CompareTo(a.Score)));\n\n    public void AddScore(int id, int score) {\n        if (players.TryGetValue(id, out var p)) {\n            board.Remove(p);\n            p.Score += score;\n        } else {\n            p = new Player { Id = id, Score = score };\n            players[id] = p;\n        }\n        board.Add(p);\n    }\n\n    public int Top(int k) {\n        int sum = 0;\n        foreach (var p in board) { if (k-- == 0) break; sum += p.Score; }\n        return sum;\n    }\n}",
