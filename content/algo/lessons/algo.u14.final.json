   "code": "public bool SearchMatrix(int[][] matrix, int target) {\n    int rows = matrix.Length, cols = matrix[0].Length;\n    int lo = 0, hi = rows * cols - 1;\n    while (lo <= hi) {\n        int mid = lo + (hi - lo) / 2;\n        int v = matrix[mid / rows][mid % rows];\n        if (v == target) return true;\n        if (v < target) lo = mid + 1;\n        else hi = mid - 1;\n    }\n    return false;\n}",
