   "code": "public bool CanPartition(int[] nums) {\n    int total = nums.Sum();\n    if (total % 2 != 0) return false;\n    int half = total / 2;\n    var ok = new bool[half + 1];\n    ok[0] = true;\n    foreach (int x in nums)\n        for (int s = x; s <= half; s++)\n            ok[s] |= ok[s - x];\n    return ok[half];\n}",
