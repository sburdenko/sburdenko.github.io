   "code": "bool NearbyDuplicate(int[] nums, int k) {\n    var last = new Dictionary<int, int>();\n    for (int i = 0; i < nums.Length; i++) {\n        if (last.TryGetValue(nums[i], out int j)\n            && i - j < k)\n            return true;\n        last[nums[i]] = i;\n    }\n    return false;\n}",
