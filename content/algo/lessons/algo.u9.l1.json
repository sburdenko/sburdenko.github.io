   "q": "⟦⟧",
   "code": "public T Pop() {\n    T top = Peek();\n    T last = a[--n];\n    a[n] = default;\n    if (n > 0) SiftDown(last, 0);\n    return top;\n}\nvoid SiftDown(T x, int i) {\n    int half = n / 2;\n    while (i < half) {\n        int c = 2 * i + 1;\n        if (cmp.Compare(a[c + 1], a[c]) < 0) c++;\n        if (cmp.Compare(x, a[c]) <= 0) break;\n        a[i] = a[c];\n        i = c;\n    }\n    a[i] = x;\n}",
