   "code": "public bool IsValid(string s) {\n    var pairs = new Dictionary<char, char> { [')'] = '(', [']'] = '[', ['}'] = '{' };\n    var stack = new Stack<char>();\n    foreach (char c in s) {\n        if (!pairs.TryGetValue(c, out char open)) stack.Push(c);\n        else if (stack.Count == 0 || stack.Pop() != open) return false;\n    }\n    return true;\n}",
