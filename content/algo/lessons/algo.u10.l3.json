   "code": "public TreeNode Lca(TreeNode root, TreeNode p, TreeNode q) {\n    var parent = new Dictionary<TreeNode, TreeNode> { [root] = null };\n    var stack = new Stack<TreeNode>();\n    stack.Push(root);\n    while (!parent.ContainsKey(p) || !parent.ContainsKey(q)) {\n        var node = stack.Pop();\n        if (node.left != null) { parent[node.left] = node; stack.Push(node.left); }\n        if (node.right != null) { parent[node.right] = node; stack.Push(node.right); }\n    }\n    var ancestors = new HashSet<TreeNode>();\n    for (var x = p; x != null; x = parent[x]) ancestors.Add(x);\n    var y = q;\n    while (!ancestors.Contains(y)) y = parent[y];\n    return y;\n}",
